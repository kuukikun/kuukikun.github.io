---
const pathname = Astro.url.pathname;
const nav = [
  { label: 'INTRO', href: '/intro/' },
  { label: 'ESSAYS', href: '/essays/' },
  { label: 'PHOTOS', href: '/photos/' },
  { label: 'ABOUT', href: '/about/' },
];
const isActive = (href: string) => pathname.startsWith(href);
---

<aside class="sidebar anim-fade">
  <h1 class="brand"><a href="/">空気喫茶店</a></h1>
  <p class="tag">存放一些零碎的想法。</p>

  <button
    class="nav-toggle-btn"
    id="navToggleBtn"
    aria-expanded="true"
    aria-controls="siteMenu"
    aria-label="收起或展开导航"
  >
    <span class="nav-switch"></span>
  </button>

  <nav class="menu" id="siteMenu" aria-label="主导航">
    {nav.map((item) => (
      <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="hr"></div>
  <p class="now-h">近况</p>
  <p class="now-b">从东京搬到了神户。<br />大概是一位，脑子里装着许多奇怪想法的 <em>in-house lawyer</em> 吧。</p>
  <span class="deco-dot"></span>
</aside>

<script>
  // 移动端 MENU 折叠（<760px）
  const b = document.getElementById('navToggleBtn');
  const m = document.getElementById('siteMenu');
  if (b && m) {
    b.addEventListener('click', () => {
      const collapsed = m.classList.toggle('collapsed');
      b.setAttribute('aria-expanded', collapsed ? 'false' : 'true');
    });
  }
</script>

<style>
  .sidebar { position: sticky; top: 96px; align-self: start; z-index: 2; }

  .brand {
    font-size: 30px;
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
    line-height: 1.2;
    margin: 0 0 16px;
  }
  .brand a { color: inherit; text-decoration: none; }
  .brand a:hover { text-decoration: none; }

  .tag {
    font-size: 15px;
    color: var(--ink-soft);
    line-height: 1.8;
    margin: 0 0 40px;
  }

  /* 导航：纵向，每项左侧预留橙点位 */
  .menu { display: flex; flex-direction: column; gap: 21px; margin-bottom: 40px; }
  .menu a {
    display: flex;
    align-items: center;
    gap: 13px;
    width: max-content;
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.22em;
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.25s ease;
  }
  .menu a::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    opacity: 0;
    transform: scale(0.45);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .menu a:hover,
  .menu a[aria-current='page'] { color: var(--accent); text-decoration: none; }
  .menu a:hover::before,
  .menu a[aria-current='page']::before { opacity: 1; transform: scale(1); }

  .hr { height: 1px; background: var(--line); margin: 6px 0 30px; }
  .now-h { font-size: 14px; color: var(--muted); letter-spacing: 0.04em; margin: 0 0 14px; }
  .now-b { font-size: 14.5px; color: var(--ink-soft); line-height: 2; margin: 0; }
  .now-b em { font-style: normal; font-family: var(--font-serif); }
  .deco-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
    display: inline-block;
    margin-top: 32px;
  }

  /* 导航开合开关（横线 + 小圆点）：仅移动端显示 */
  .nav-toggle-btn { display: none; }

  @media (max-width: 760px) {
    .sidebar { position: static; }
    .brand { font-size: 26px; margin-bottom: 10px; }
    .tag { margin-bottom: 22px; }

    /* 移动端默认直接展开四个栏目；收起时隐藏 */
    .menu.collapsed { display: none; }

    .nav-toggle-btn {
      display: inline-flex;
      align-items: center;
      background: none;
      border: 0;
      padding: 4px 0;
      margin-bottom: 18px;
      cursor: pointer;
    }
    .nav-switch { position: relative; display: inline-block; width: 32px; height: 10px; }
    .nav-switch::before {
      content: '';
      position: absolute;
      top: 50%;
      left: 0;
      right: 0;
      height: 1px;
      background: var(--line);
      transform: translateY(-50%);
    }
    .nav-switch::after {
      content: '';
      position: absolute;
      top: 50%;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--accent);
      transform: translateY(-50%);
      left: calc(100% - 9px); /* 展开：圆点在右 */
      transition: left 0.3s ease, background 0.3s ease;
    }
    /* 收起：圆点滑到左端并转为弱化色 */
    .nav-toggle-btn[aria-expanded='false'] .nav-switch::after {
      left: 0;
      background: var(--muted);
    }

    .hr { margin: 24px 0; }
  }
</style>
