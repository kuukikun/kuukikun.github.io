---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { excerpts } from '../data/excerpts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const recent = posts.slice(0, 3);
const fmt = (d: Date) =>
  `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}.${String(d.getDate()).padStart(2, '0')}`;
---

<BaseLayout title="空気の喫茶店">
  <div class="home">
    <p class="quote" id="quote" set:html={excerpts[0]}></p>

    <div class="recent3">
      <p class="r3h">最近</p>
      {recent.map((p) => (
        <a class="r3" href={`/posts/${p.id}/`}>
          <span class="d">{fmt(p.data.date)}</span>
          <span class="n">{p.data.title}</span>
        </a>
      ))}
      <a class="more" href="/essays/">MORE →</a>
    </div>
  </div>
</BaseLayout>

<script define:vars={{ excerpts }}>
  // 轮换句：4.2s 交叉淡入；prefers-reduced-motion 时不轮换、停在第一句
  const q = document.getElementById('quote');
  const reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (q && !reduce && excerpts.length >= 2) {
    let i = 0;
    setInterval(() => {
      q.style.opacity = '0';
      setTimeout(() => {
        i = (i + 1) % excerpts.length;
        q.innerHTML = excerpts[i];
        q.style.opacity = '1';
      }, 900);
    }, 4200);
  }
</script>

<style>
  /* 右栏极简门户：垂直居中 */
  .home {
    min-height: 430px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .quote {
    font-size: 30px;
    line-height: 1.85;
    font-weight: 500;
    color: var(--ink);
    max-width: 18ch;
    margin: 0;
    transition: opacity 0.9s ease;
  }
  .quote :global(.qmark) { color: var(--accent); }

  .recent3 { margin-top: 64px; }
  .r3h {
    font-family: var(--font-serif);
    font-size: 12px;
    letter-spacing: 0.3em;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .r3 {
    display: flex;
    gap: 18px;
    align-items: baseline;
    padding: 11px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }
  .r3 .d {
    font-family: var(--font-serif);
    font-size: 12px;
    color: var(--faint);
    min-width: 78px;
  }
  .r3 .n { font-size: 15px; color: var(--ink-soft); transition: color 0.2s ease; }
  .r3:hover { text-decoration: none; }
  .r3:hover .n { color: var(--accent); }

  .more {
    display: inline-block;
    margin-top: 22px;
    font-family: var(--font-serif);
    font-size: 13px;
    letter-spacing: 0.18em;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .more:hover { color: var(--accent); text-decoration: none; }

  @media (max-width: 760px) {
    .home { min-height: auto; margin-top: 8px; }
    .quote { font-size: 24px; }
    .recent3 { margin-top: 40px; }
  }
</style>
