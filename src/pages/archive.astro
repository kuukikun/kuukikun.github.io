---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostListItem from '../components/PostListItem.astro';

// 全部帖子（随笔 + 摄影日记）按时间倒序混合
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<BaseLayout title="全部" description="空気の喫茶店 · 全部文章">
  <header class="page-head">
    <p class="eyebrow">All</p>
    <p class="lede">随笔与摄影日记，按时间排列，共 {posts.length} 篇。</p>
  </header>
  <div class="list">
    {posts.map((post) => <PostListItem post={post} />)}
  </div>
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 1.8rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .page-head .eyebrow { font-size: 0.78rem; }
  .lede {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
</style>
