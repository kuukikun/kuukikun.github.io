---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostListItem from '../../components/PostListItem.astro';

const posts = (
  await getCollection('posts', ({ data }) => !data.draft && data.type === 'photo')
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title="摄影日记" description="空気喫茶店 · 摄影日记">
  <header class="page-head">
    <p class="eyebrow">Photos</p>
    <p class="lede">以照片为主的摄影日记，共 {posts.length} 篇。</p>
  </header>
  {posts.length > 0 ? (
    <div class="list">
      {posts.map((post) => <PostListItem post={post} />)}
    </div>
  ) : (
    <p class="empty">还没有摄影日记，敬请期待。</p>
  )}
</BaseLayout>

<style>
  .page-head {
    margin-bottom: 1.8rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--line);
  }
  .page-head .eyebrow { font-size: 0.78rem; }
  .lede {
    margin: 0.5rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-soft);
  }
  .empty { color: var(--muted); }
</style>
